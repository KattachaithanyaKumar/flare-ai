PORT=3000

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Comma-separated origins allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# LLM provider: "ollama" for local qwen, "gemini" for the deployed API.
# Optional: defaults to "gemini" when GEMINI_API_KEY is set, otherwise "ollama".
# LLM_PROVIDER=gemini

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Set to true to enable qwen3 thinking mode (slower, more deliberate)
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=30m

# Gemini (deployed)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# # Thinking level: low | medium | high
# GEMINI_REASONING_EFFORT=low

# # Max time to wait for a chat response (ms)
# CHAT_TIMEOUT_MS=60000

# In-memory response cache
# CHAT_CACHE_TTL_MS=3600000
# CHAT_CACHE_MAX=500
# # 0 disables similar-question matching; 1 requires identical wording
# CHAT_CACHE_SIMILARITY=0.85
